# Generate with scripts/setup.ps1 or scripts/setup.sh. Never commit .env.
RUNNER_TOKEN=replace-with-another-random-64-hex-secret
ADMIN_LOGIN=admin
# Single quotes protect bcrypt dollar signs from Docker Compose interpolation.
ADMIN_PASSWORD_HASH='replace-with-bcrypt-hash'
# Optional configuration file inside the mounted /config directory.
STAFF_ACCOUNTS_FILE=
APP_URL=http://localhost:3000
COOKIE_SECURE=false
APP_TIMEZONE=Asia/Yekaterinburg
# Only seeds the initial date; the teacher changes it in Groups and login.
SEMESTER_END=
SEED_PRACTICE=true
WORKERS=2
BIND_ADDRESS=127.0.0.1
PORT=3000
WEB_SUBNET=172.29.240.0/24
